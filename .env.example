# Director Mode — Environment Variables
# Copy this file to .env and fill in your values.

# ---------- Authentication (pick one) ----------

# Option 1: Gemini API key (Google AI Studio)
GEMINI_API_KEY=your-gemini-api-key-here

# Option 2: Vertex AI (GCP project)
# GCP_PROJECT_ID=your-gcp-project-id
# GCP_REGION=us-central1

# ---------- Model IDs ----------

# Standard text model (for REST API fallback)
GEMINI_MODEL=gemini-2.5-flash-preview-05-20

# Live streaming model (for bidirectional audio)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio

# ---------- Server ----------

# CORS allowed origins (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Server port
PORT=8000
