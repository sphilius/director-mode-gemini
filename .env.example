# Director Mode — Environment Variables
# Copy this file to .env and fill in your values.

# Google Gemini API key (required)
GEMINI_API_KEY=your_key

# --- CORE SETTINGS ---
PORT=8080
# Pointing to local backend for development
VITE_WS_URL=ws://localhost:8000
CORS_ORIGINS=http://localhost:5173

# --- GOOGLE CLOUD & VERTEX AI CONFIG ---
VERTEX_AI_PROJECT=your_project_ID
VERTEX_AI_LOCATION=us-central1

# --- GENERATIVE AI MODELS (MARCH 2026) ---

# Best for Reasoning & Story Direction (Chat)
GEMINI_MODEL=gemini-3.1-pro-preview

# Best for Real-Time/Live Interaction (Low Latency)
GEMINI_LIVE_MODEL=gemini-2.5-flash-native-audio-preview-12-2025

# Best for Image Generation (Upgraded from 3.1)
VERTEX_AI_IMAGE_MODEL=imagen-4.0-generate-001

# Best for Video Generation
VERTEX_AI_VIDEO_MODEL=veo-3.1-generate-preview

# Music Generation (Legacy/Stable)
VERTEX_AI_MUSIC_MODEL=lyria-002